# .env.example
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file.
#
# cp .env.example .env

# ---------------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sentinel1_flood
DB_USER=postgres
DB_PASSWORD=your_password_here

# Connection pool settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false   # set true to log all SQL queries (dev only)

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# ---------------------------------------------------------------------------
# PIPELINE PATHS
# ---------------------------------------------------------------------------
OUTPUT_DIR=processed
LOGS_DIR=logs_pipeline
CHECKPOINT_DIR=checkpoints_pipeline
ANALYTICS_DIR=analytics

# ---------------------------------------------------------------------------
# OPTIONAL: Cloud storage (for S3/GCS product upload)
# ---------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-southeast-1
# S3_BUCKET_NAME=

# GCS_PROJECT_ID=
# GCS_BUCKET_NAME=
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service_account.json
