{
  "_comment": "Konfigurasi pipeline Sentinel-1. Edit sesuai kebutuhan lalu restart server.",
  "_coord_source": "Koordinat diverifikasi dari Biro Pemerintahan Pemprov DKI Jakarta + OpenStreetMap",

  "area": {
    "selected_regions": ["dki_jakarta"],
    "bbox_wkt": "POLYGON((106.2948 -6.3724, 106.9734 -6.3724, 106.9734 -5.6024, 106.2948 -5.6024, 106.2948 -6.3724))",
    "time_mode": "relative",
    "days_back": 90,
    "date_from": "2024-01-01",
    "date_to":   "2024-12-31",
    "orbit_ascending":  true,
    "orbit_descending": false
  },

  "pipeline": {
    "lee_window_size": 7,
    "lee_looks":       1,
    "cog_compression": "LZW",
    "cog_blocksize":   512,
    "cog_convert_db":  false,
    "retry_count":     3,
    "retry_delay_sec": 30,

    "check_interval_hours": 12,
    "max_scenes_per_run":   20,

    "output_dir":   "processed",
    "raw_dir":      "recovered_temp",

    "keep_raw":    false,
    "keep_bronze": true,
    "keep_silver": true
  },

  "quality": {
    "min_quality_score":       60,
    "max_nodata_percent":      30,
    "cloud_threshold_percent": 20,
    "alert_on_fail":    true,
    "alert_on_arrival": true,
    "alert_on_error":   true
  },

  "storage_presets": {
    "_comment": "Copy salah satu preset ke bagian 'pipeline' di atas sesuai kebutuhan.",
    "minimal": {
      "keep_raw": false, "keep_bronze": false, "keep_silver": false,
      "_note": "Hanya simpan GOLD (~40 MB/scene/band). Paling hemat."
    },
    "standard": {
      "keep_raw": false, "keep_bronze": true, "keep_silver": true,
      "_note": "Hapus ZIP asli, simpan semua hasil olahan (~130 MB/scene/band)."
    },
    "full": {
      "keep_raw": true, "keep_bronze": true, "keep_silver": true,
      "_note": "Simpan semuanya termasuk ZIP asli (~870 MB/scene/band). Paling aman."
    }
  }
}